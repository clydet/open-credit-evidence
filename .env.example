# Copy to .env (gitignored). Generate the key at https://build.nvidia.com -> Manage API Keys.
# Never commit the real value.

# Required for live mode (not needed for --stub)
NVIDIA_API_KEY=nvapi-...

# Optional: override default model (see src/evidence/adapters/nvidia_build.py)
# NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional: enable thinking mode for the assistant (default: false for assistant, true for judge)
# NEMOTRON_ENABLE_THINKING=false
