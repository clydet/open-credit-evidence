# Copy to .env (gitignored). With the four served roles below pointed at the
# team's node, a local run needs no key at all. The key is only used for a role
# left on NVIDIA Build (comment its two lines out to do that) and by the Hugging
# Face Space, which cannot reach the node. Generate one at build.nvidia.com ->
# Manage API Keys; never commit the real value.
NVIDIA_API_KEY=nvapi-...

# Where the five roles run. The team's servers are one SLURM job on the Codefest
# cluster (scripts/cluster/servers.sbatch); the job publishes its node and ports
# to /data/team08/runs/servers.env — copy that file's eight lines here. VPN
# required (docs/cluster.md). Comment a role's lines out to use NVIDIA Build.
EVIDENCE_ASSISTANT_BASE_URL=http://10.130.232.21:8200/v1
EVIDENCE_ASSISTANT_MODEL=nvidia/nemotron-3.5-lightning

# The judge (and the judge panel): the Nemotron 3 Super 120B-A12B NIM on the same node,
# with tool calling on.
# Comment out to judge with Nemotron 3 Ultra on NVIDIA Build instead.
EVIDENCE_JUDGE_BASE_URL=http://10.130.232.21:8201/v1
EVIDENCE_JUDGE_MODEL=nemotron-3-super

# The embedder (corpus build and the judge's retrieval query): the Nemotron 3
# Embed 1B NIM on the node. It takes the query/passage role as a parameter; for a
# plain vLLM server of the raw checkpoint set EVIDENCE_EMBED_ROLE_STYLE=prefix.
EVIDENCE_EMBED_BASE_URL=http://10.130.232.21:8202/v1
EVIDENCE_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# The teacher: used only by `evidence distill` to generate fine-tuning data.
# Defaults to Nemotron 3 Ultra on NVIDIA Build. No team server serves Ultra,
# so these lines are commented; uncomment and adjust the host if you deploy it.
# EVIDENCE_TEACHER_BASE_URL=http://10.130.232.21:8203/v1
# EVIDENCE_TEACHER_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# The candidate: the fine-tuned Lightning (LoRA) served by serve_lightning_ft.sh,
# offered in the web UI beside the assistant. Omitting these lines hides the
# candidate from the UI.
EVIDENCE_CANDIDATE_BASE_URL=http://10.130.232.21:8210/v1
EVIDENCE_CANDIDATE_MODEL=lightning-credit-fig-v2

# The node's side of the model fingerprints (image digests, weights hashes),
# written by the servers job to /data/team08/runs/models.json. Default ./models.json.
# EVIDENCE_MODELS_FILE=models.json
