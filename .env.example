# Copy to .env (gitignored). Generate the key at https://build.nvidia.com -> Manage API Keys.
# Never commit the real value.
NVIDIA_API_KEY=nvapi-...

# ---------------------------------------------------------------------------
# Per-role model overrides
# ---------------------------------------------------------------------------
# The adapter's endpoint_for(role) resolves EVIDENCE_<ROLE>_BASE_URL and
# EVIDENCE_<ROLE>_MODEL for any role.  Omit both to use the NVIDIA Build
# default for that role.  The five roles are: assistant, judge, embed,
# teacher, candidate.
#
# If you run the team vLLM servers (scripts/cluster/servers.sbatch), copy
# the eight lines it writes to servers.env here.

# assistant — the model under test (Lightning 30B by default)
# EVIDENCE_ASSISTANT_BASE_URL=http://10.130.232.21:8200/v1
# EVIDENCE_ASSISTANT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# judge — grades briefing quality (Ultra 550B by default)
# EVIDENCE_JUDGE_BASE_URL=http://10.130.232.21:8201/v1
# EVIDENCE_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# embed — retriever for RAG (Embed 1B by default)
# EVIDENCE_EMBED_BASE_URL=http://10.130.232.21:8202/v1
# EVIDENCE_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# teacher — used only by `evidence distill` to generate fine-tuning data;
# default is Nemotron 3 Ultra on NVIDIA Build.  The team servers job does
# not serve Ultra, so uncomment and point to your own endpoint if needed.
# EVIDENCE_TEACHER_BASE_URL=http://<your-host>:8203/v1
# EVIDENCE_TEACHER_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# candidate — the fine-tuned Lightning (LoRA) served on the team node,
# offered in the web UI beside the assistant.  No default in code; leaving
# these lines out hides the candidate from the UI.
# EVIDENCE_CANDIDATE_BASE_URL=http://10.130.232.21:8210/v1
# EVIDENCE_CANDIDATE_MODEL=lightning-credit-fig-v2
